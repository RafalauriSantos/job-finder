# Notificações via Telegram (Recomendado)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Recomendado para chats/grupos: restringe o recebimento ao seu usuário Telegram.
TELEGRAM_ALLOWED_USER_ID=

# Supervisão externa Cloudflare (opcional até o Worker ser publicado)
WORKHUNTER_HEARTBEAT_URL=
WORKHUNTER_HEARTBEAT_TOKEN=

# Fallback de e-mail quando o Telegram falhar (Resend)
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Notificações via Discord (Opcional - caso prefira Webhook)
DISCORD_WEBHOOK_URL=

# Juiz Semântico LLM configurável
# Provedor padrão: gemini. Alternativa: openrouter.
LLM_PROVIDER=gemini
# Se vazio, usa o modelo padrão do provider escolhido.
LLM_MODEL=

# Gemini
GEMINI_API_KEY=

# OpenRouter (usado quando LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=

# Coleta complementar do LinkedIn (opcional; extensão/Playwright local)
LINKEDIN_MAX_ACTIONS_PER_HOUR=12
LINKEDIN_MIN_INTERVAL_SECONDS=120
# Caminho local do perfil persistente; mantenha-o fora do repositório.
LINKEDIN_BROWSER_PROFILE=
