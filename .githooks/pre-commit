#!/usr/bin/env bash
set -euo pipefail

# Block common credential formats before they enter Git history. This is a
# local defense in depth; credentials must still live outside the repository.
if git diff --cached --unified=0 --binary -- . \
    | rg -q -i \
      '(^|[ =:\"'"'"'])((sk|rk)-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,}|re_[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{20,}|xox[baprs]-[0-9A-Za-z-]{20,}|[0-9]{6,}:[A-Za-z0-9_-]{20,})(["'"'"' ,;}]|$)'; then
  echo 'Commit bloqueado: possível segredo detectado nos arquivos staged.' >&2
  echo 'Mantenha credenciais em ~/.job-finder/secrets.env e remova-as do staged.' >&2
  exit 1
fi
